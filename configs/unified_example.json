{
  "schema_version": 1,
  "output_dir": "../outputs/example",
  "runtime": {
    "foundation_python": "",
    "scan_python": ""
  },
  "cpd": {
    "tv": {
      "weight": 2.0,
      "max_iterations": 200,
      "tolerance": 1e-05,
      "drop_edge_statistics": true
    },
    "windows": {
      "min_window": 15,
      "n_windows": 7,
      "seed": 0
    },
    "scan": {
      "alpha": 0.05,
      "n_boot": 19,
      "taper": "tukey",
      "change_type": "distribution",
      "random_state": 0,
      "n_jobs": 1,
      "vote_thresholds": [
        0.25,
        0.4,
        0.5,
        0.6
      ]
    }
  },
  "jobs": [
    {
      "id": "series_summary",
      "modality": "time_series",
      "input": {
        "path": "../examples/series.npy"
      },
      "model": {
        "key": "summary",
        "backend": "summary",
        "batch_size": 32
      },
      "embedding": {
        "context_length": 32,
        "stride": 1,
        "device": "cpu"
      }
    },
    {
      "id": "vision_saved",
      "modality": "embeddings",
      "input": {
        "path": "../examples/vision_embeddings.npz"
      },
      "cpd": {
        "tv": {
          "drop_edge_statistics": false
        }
      }
    }
  ]
}